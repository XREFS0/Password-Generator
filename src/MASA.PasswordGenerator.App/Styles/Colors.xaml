<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Brand Colors -->
    <Color x:Key="PrimaryColor">#6366F1</Color>
    <Color x:Key="PrimaryHoverColor">#4F46E5</Color>
    <Color x:Key="PrimaryPressedColor">#4338CA</Color>
    
    <Color x:Key="SecondaryColor">#EC4899</Color>
    <Color x:Key="SecondaryHoverColor">#DB2777</Color>
    
    <Color x:Key="AccentCyanColor">#06B6D4</Color>
    <Color x:Key="SuccessGreenColor">#10B981</Color>
    <Color x:Key="WarningAmberColor">#F59E0B</Color>
    <Color x:Key="DangerRedColor">#EF4444</Color>

    <!-- Dark Palette Tokens (Default) -->
    <Color x:Key="DarkBgRoot">#0F172A</Color>
    <Color x:Key="DarkBgSidebar">#1E293B</Color>
    <Color x:Key="DarkBgCard">#1E293B</Color>
    <Color x:Key="DarkBgCardHover">#273549</Color>
    <Color x:Key="DarkBgInput">#0F172A</Color>
    <Color x:Key="DarkBorder">#334155</Color>
    <Color x:Key="DarkBorderFocus">#6366F1</Color>
    
    <Color x:Key="DarkTextPrimary">#F8FAFC</Color>
    <Color x:Key="DarkTextSecondary">#94A3B8</Color>
    <Color x:Key="DarkTextMuted">#64748B</Color>

    <!-- Dynamic Theme Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource SecondaryHoverColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessGreenColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningAmberColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerRedColor}"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}"/>

    <SolidColorBrush x:Key="BgRootBrush" Color="{StaticResource DarkBgRoot}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource DarkBgSidebar}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource DarkBgCard}"/>
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource DarkBgCardHover}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource DarkBgInput}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorder}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource DarkBorderFocus}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource DarkTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource DarkTextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource DarkTextMuted}"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VibrantHeroGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#A855F7" Offset="0.5"/>
        <GradientStop Color="#EC4899" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>

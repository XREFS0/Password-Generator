<UserControl x:Class="MASA.PasswordGenerator.App.Views.GeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MASA.PasswordGenerator.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="850">
    <UserControl.Resources>
        <converters:StrengthToColorConverter x:Key="StrengthToColorConverter"/>
        <converters:StrengthToProgressConverter x:Key="StrengthToProgressConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- Title -->
            <TextBlock Text="Password Generator" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="Customize parameters to generate cryptographically random, ultra-secure passwords." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,25"/>

            <!-- Result Card -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GeneratedPassword, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontSize="20"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontWeight="Bold"
                                 Padding="14,12"
                                 Background="{DynamicResource BgInputBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"/>
                        <Button Grid.Column="1"
                                Style="{DynamicResource ModernSecondaryButton}"
                                Content="Copy"
                                Command="{Binding CopyPasswordCommand}"
                                Margin="10,0,0,0"
                                Padding="20,10"/>
                        <Button Grid.Column="2"
                                Style="{DynamicResource ModernPrimaryButton}"
                                Content="Generate"
                                Command="{Binding GeneratePasswordCommand}"
                                Margin="10,0,0,0"
                                Padding="22,10"/>
                    </Grid>

                    <!-- Strength Meter -->
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Strength: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding Strength.StrengthLabel}" 
                                       FontWeight="Bold"
                                       Foreground="{Binding Strength.Strength, Converter={StaticResource StrengthToColorConverter}}"
                                       FontSize="13"/>
                        </StackPanel>

                        <ProgressBar Grid.Column="1"
                                     Height="8"
                                     Margin="20,0"
                                     Value="{Binding Strength.Strength, Converter={StaticResource StrengthToProgressConverter}}"
                                     Foreground="{Binding Strength.Strength, Converter={StaticResource StrengthToColorConverter}}"
                                     Background="{DynamicResource BgCardHoverBrush}"
                                     BorderThickness="0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding Strength.EntropyBits, StringFormat='Entropy: {0:F1} bits'}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Notification Feedback -->
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="10,6" Margin="0,15,0,0"
                            Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CopyNotification}" Foreground="White" FontWeight="Medium" FontSize="13"/>
                    </Border>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="13" Margin="0,10,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Presets Bar -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Quick Presets" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{DynamicResource ModernSecondaryButton}" Content="Simple (12 chars)" Command="{Binding ApplyPresetCommand}" CommandParameter="Simple" Margin="0,0,10,10"/>
                        <Button Style="{DynamicResource ModernSecondaryButton}" Content="Strong (16 chars)" Command="{Binding ApplyPresetCommand}" CommandParameter="Strong" Margin="0,0,10,10"/>
                        <Button Style="{DynamicResource ModernSecondaryButton}" Content="Maximum Security (32 chars)" Command="{Binding ApplyPresetCommand}" CommandParameter="Max" Margin="0,0,10,10"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Configuration Card -->
            <Border Style="{DynamicResource ModernCard}">
                <StackPanel>
                    <TextBlock Text="Password Configuration" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                    <!-- Length Slider -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Password Length" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1"
                                Minimum="4"
                                Maximum="128"
                                Value="{Binding Length, Mode=TwoWay}"
                                Margin="25,0"
                                VerticalAlignment="Center"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60"
                                 Style="{DynamicResource ModernTextBox}"
                                 HorizontalContentAlignment="Center"
                                 FontWeight="Bold"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,20"/>

                    <!-- Character Options Toggles -->
                    <TextBlock Text="Character Types" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>
                    <UniformGrid Columns="2" Margin="0,0,0,15">
                        <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Uppercase Letters (A-Z)" IsChecked="{Binding IncludeUppercase, Mode=TwoWay}" Margin="0,0,0,12"/>
                        <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Lowercase Letters (a-z)" IsChecked="{Binding IncludeLowercase, Mode=TwoWay}" Margin="0,0,0,12"/>
                        <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Numbers (0-9)" IsChecked="{Binding IncludeDigits, Mode=TwoWay}" Margin="0,0,0,12"/>
                        <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Symbols (!@#$%^&amp;*)" IsChecked="{Binding IncludeSymbols, Mode=TwoWay}" Margin="0,0,0,12"/>
                    </UniformGrid>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,20"/>

                    <!-- Exclusions -->
                    <TextBlock Text="Exclusions &amp; Ambiguity" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>
                    <CheckBox Style="{DynamicResource ModernCheckBox}" 
                              Content="Exclude Similar Characters (e.g. i, l, 1, L, o, 0, O)" 
                              IsChecked="{Binding ExcludeSimilarCharacters, Mode=TwoWay}" 
                              Margin="0,0,0,12"/>
                    <CheckBox Style="{DynamicResource ModernCheckBox}" 
                              Content="Exclude Ambiguous Symbols (e.g. { } [ ] ( ) / \ ' &quot; ` ~ , ; :)" 
                              IsChecked="{Binding ExcludeAmbiguousSymbols, Mode=TwoWay}" 
                              Margin="0,0,0,20"/>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,20"/>

                    <!-- Custom Characters -->
                    <TextBlock Text="Custom Characters" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding CustomCharacters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource ModernTextBox}"
                             Margin="0,0,0,10"/>
                    <CheckBox Style="{DynamicResource ModernCheckBox}" 
                              Content="Use Custom Characters ONLY (ignores character classes above)" 
                              IsChecked="{Binding UseCustomCharactersOnly, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="MASA.PasswordGenerator.App.Views.CheckerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MASA.PasswordGenerator.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="850">
    <UserControl.Resources>
        <converters:StrengthToColorConverter x:Key="StrengthToColorConverter"/>
        <converters:StrengthToProgressConverter x:Key="StrengthToProgressConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- Title -->
            <TextBlock Text="Password Checker &amp; Analyzer" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="Test password resilience against brute-force attacks, sequential flaws, and known breach dictionaries entirely offline." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,25"/>

            <!-- Input Box Card -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Enter Password to Analyze" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Clear / Masked text toggling -->
                        <TextBox Text="{Binding PasswordInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 FontFamily="Consolas, Cascadia Code"
                                 FontWeight="Bold"
                                 Padding="14,12"
                                 Style="{DynamicResource ModernTextBox}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                        <PasswordBox x:Name="pwdBox"
                                     FontSize="18"
                                     Padding="14,12"
                                     Background="{DynamicResource BgInputBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>

                        <Button Grid.Column="1"
                                Style="{DynamicResource ModernSecondaryButton}"
                                Content="Show / Hide"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                Margin="10,0,0,0"
                                Padding="15,10"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Analysis Overview Card -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Strength Assessment" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding StrengthResult.StrengthLabel}" 
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="{Binding StrengthResult.Strength, Converter={StaticResource StrengthToColorConverter}}"/>

                        <ProgressBar Grid.Column="1"
                                     Height="10"
                                     Margin="20,0"
                                     Value="{Binding StrengthResult.Strength, Converter={StaticResource StrengthToProgressConverter}}"
                                     Foreground="{Binding StrengthResult.Strength, Converter={StaticResource StrengthToColorConverter}}"
                                     Background="{DynamicResource BgCardHoverBrush}"
                                     BorderThickness="0"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding StrengthResult.Score, StringFormat='Score: {0}/100'}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"/>
                    </Grid>

                    <UniformGrid Columns="3" Margin="0,10,0,10">
                        <Border Background="{DynamicResource BgCardHoverBrush}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Entropy" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding StrengthResult.EntropyBits, StringFormat='{}{0:F1} bits'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgCardHoverBrush}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Length / Uniques" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding StrengthResult.UniqueCharacterCount, StringFormat='{}{0} unique chars'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgCardHoverBrush}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Est. Crack Time" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding StrengthResult.CrackTimeEstimate}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Warnings -->
                    <ItemsControl ItemsSource="{Binding StrengthResult.Warnings}" Margin="0,15,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#451A1A" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding StringFormat='⚠️ {0}'}" Foreground="#FCA5A5" FontWeight="Medium" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Suggestions -->
                    <ItemsControl ItemsSource="{Binding StrengthResult.Suggestions}" Margin="0,5,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardHoverBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding StringFormat='💡 {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Breach Check (k-Anonymity) Card -->
            <Border Style="{DynamicResource ModernCard}">
                <StackPanel>
                    <TextBlock Text="Data Breach Verification (k-Anonymity)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Utilizes mathematical k-Anonymity (SHA-1 5-character prefix). Raw passwords are NEVER transmitted over the internet." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>

                    <Button Style="{DynamicResource ModernSecondaryButton}" 
                            Content="Check If Password Was Breached (Optional)"
                            Command="{Binding CheckBreachCommand}"
                            HorizontalAlignment="Left"
                            Padding="20,10"/>

                    <TextBlock Text="{Binding BreachResult.Message}" 
                               Foreground="{DynamicResource AccentCyanBrush}" 
                               FontWeight="SemiBold"
                               FontSize="14" 
                               Margin="0,15,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding BreachResult, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="MASA.PasswordGenerator.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MASA.PasswordGenerator.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">
    <UserControl.Resources>
        <converters:StrengthToColorConverter x:Key="StrengthToColorConverter"/>
        <converters:StrengthToProgressConverter x:Key="StrengthToProgressConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- Header Hero Card -->
            <Border Background="{DynamicResource VibrantHeroGradient}" CornerRadius="16" Padding="30" Margin="0,0,0,25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Welcome to MASA Password Generator" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <TextBlock Text="Cryptographically secure password generation with CSPRNG, Shannon entropy, and local privacy." FontSize="14" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Generator Output Card -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Instant Password Generator" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>
                    
                    <!-- Password Box & Copy Action -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding QuickPassword, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontSize="18"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontWeight="Bold"
                                 Padding="14,12"
                                 Background="{DynamicResource BgInputBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"/>
                        <Button Grid.Column="1"
                                Style="{DynamicResource ModernSecondaryButton}"
                                Content="Copy"
                                Command="{Binding CopyPasswordCommand}"
                                Margin="10,0,0,0"
                                Padding="20,10"/>
                        <Button Grid.Column="2"
                                Style="{DynamicResource ModernPrimaryButton}"
                                Content="Generate"
                                Command="{Binding GenerateStrongPasswordCommand}"
                                Margin="10,0,0,0"
                                Padding="20,10"/>
                    </Grid>

                    <!-- Strength & Entropy details -->
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Strength: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding QuickStrength.StrengthLabel}" 
                                       FontWeight="Bold"
                                       Foreground="{Binding QuickStrength.Strength, Converter={StaticResource StrengthToColorConverter}}"
                                       FontSize="13"/>
                        </StackPanel>

                        <ProgressBar Grid.Column="1"
                                     Height="8"
                                     Margin="20,0"
                                     Value="{Binding QuickStrength.Strength, Converter={StaticResource StrengthToProgressConverter}}"
                                     Foreground="{Binding QuickStrength.Strength, Converter={StaticResource StrengthToColorConverter}}"
                                     Background="{DynamicResource BgCardHoverBrush}"
                                     BorderThickness="0"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding QuickStrength.EntropyBits, StringFormat='Entropy: {0:F1} bits'}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"/>
                    </Grid>

                    <!-- Feedback Alert -->
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="10,6" Margin="0,15,0,0"
                            Visibility="{Binding IsCopyStatusVisible, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CopyStatusMessage}" Foreground="White" FontWeight="Medium" FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Quick Action Cards Grid -->
            <TextBlock Text="Quick Actions" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>
            <UniformGrid Columns="3" Margin="-8,0,-8,0">
                <Border Style="{DynamicResource ModernCard}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Strong Password" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="16 characters with letters, numbers, and symbols." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,15" TextWrapping="Wrap"/>
                        <Button Style="{DynamicResource ModernPrimaryButton}" Content="Generate" Command="{Binding GenerateStrongPasswordCommand}"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource ModernCard}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Memorable Passphrase" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Diceware multi-word phrase with separator &amp; numbers." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,15" TextWrapping="Wrap"/>
                        <Button Style="{DynamicResource ModernSecondaryButton}" Content="Generate Passphrase" Command="{Binding GeneratePassphraseCommand}"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource ModernCard}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Secure PIN Code" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Cryptographically random 6-digit numeric passcode." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,15" TextWrapping="Wrap"/>
                        <Button Style="{DynamicResource ModernSecondaryButton}" Content="Generate PIN" Command="{Binding GeneratePinCommand}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="MASA.PasswordGenerator.App.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MASA.PasswordGenerator.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="850">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- Header -->
            <TextBlock Text="Password Policies &amp; Custom Character Sets" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="Validate passwords against compliance policies (Windows AD, NIST) or define custom alphanumeric alphabets." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,25"/>

            <!-- Policy Compliance Card -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Enterprise Policy Validator &amp; Generator" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Select Policy:" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding Policies}" 
                                  SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Padding="10,8"
                                  FontSize="14"/>
                    </Grid>

                    <TextBlock Text="{Binding SelectedPolicy.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,15"/>

                    <!-- Generate Compliant Password -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GeneratedPolicyPassword, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontSize="16"
                                 FontFamily="Consolas, Cascadia Code"
                                 FontWeight="Bold"
                                 Padding="12,10"
                                 Background="{DynamicResource BgInputBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"/>
                        <Button Grid.Column="1"
                                Style="{DynamicResource ModernSecondaryButton}"
                                Content="Copy"
                                Command="{Binding CopyGeneratedCommand}"
                                Margin="10,0,0,0"
                                Padding="15,10"/>
                        <Button Grid.Column="2"
                                Style="{DynamicResource ModernPrimaryButton}"
                                Content="Generate Compliant"
                                Command="{Binding GenerateCompliantPasswordCommand}"
                                Margin="10,0,0,0"
                                Padding="15,10"/>
                    </Grid>

                    <!-- Test Compliance Box -->
                    <TextBlock Text="Or Test Custom Password Against Policy:" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,8"/>
                    <TextBox Text="{Binding TestPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource ModernTextBox}"
                             Margin="0,0,0,12"/>

                    <!-- Compliance Status Badge -->
                    <Border Background="{DynamicResource BgCardHoverBrush}" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Compliance Status: " FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="COMPLIANT" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" FontSize="14" Visibility="{Binding ValidationResult.IsCompliant, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="NON-COMPLIANT" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="14">
                                    <TextBlock.Visibility>
                                        <Binding Path="ValidationResult.IsCompliant" Converter="{StaticResource BoolToVis}" ConverterParameter="invert"/>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </StackPanel>

                            <!-- Errors list -->
                            <ItemsControl ItemsSource="{Binding ValidationResult.Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{DynamicResource DangerBrush}" FontSize="13" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Custom Character Sets Management -->
            <Border Style="{DynamicResource ModernCard}">
                <StackPanel>
                    <TextBlock Text="Custom Character Sets &amp; Presets" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CustomCharSetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}"
                                 Tag="Preset Name (e.g. Base32)"
                                 Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding CustomCharSetCharacters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}"
                                 Tag="Characters (e.g. ABCDEF12345)"
                                 Margin="0,0,10,0"/>
                        <Button Grid.Column="2"
                                Style="{DynamicResource ModernPrimaryButton}"
                                Content="Add Preset"
                                Command="{Binding AddCustomPresetCommand}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CustomPresets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardHoverBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Options.CustomCharacters}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{DynamicResource ModernSecondaryButton}"
                                                Content="Remove"
                                                Padding="10,4"
                                                Command="{Binding DataContext.DeleteCustomPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

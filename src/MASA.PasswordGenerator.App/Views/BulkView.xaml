<UserControl x:Class="MASA.PasswordGenerator.App.Views.BulkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MASA.PasswordGenerator.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:StrengthToColorConverter x:Key="StrengthToColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Bulk Password Generator" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="Generate hundreds of cryptographic passwords simultaneously with custom export options." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Controls Bar -->
        <Border Grid.Row="1" Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Quantity:" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" HorizontalContentAlignment="Center"/>

                    <TextBlock Grid.Column="3" Text="Length:" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="4" Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" HorizontalContentAlignment="Center"/>

                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button Style="{DynamicResource ModernPrimaryButton}" Content="Generate Passwords" Command="{Binding GenerateBulkCommand}" Margin="0,0,10,0"/>
                        <Button Style="{DynamicResource ModernSecondaryButton}" Content="Copy All" Command="{Binding CopyAllCommand}"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,5,0,10">
                    <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Uppercase" IsChecked="{Binding IncludeUppercase, Mode=TwoWay}" Margin="0,0,20,0"/>
                    <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Lowercase" IsChecked="{Binding IncludeLowercase, Mode=TwoWay}" Margin="0,0,20,0"/>
                    <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Numbers" IsChecked="{Binding IncludeDigits, Mode=TwoWay}" Margin="0,0,20,0"/>
                    <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Symbols" IsChecked="{Binding IncludeSymbols, Mode=TwoWay}" Margin="0,0,20,0"/>
                    <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Exclude Similar" IsChecked="{Binding ExcludeSimilarCharacters, Mode=TwoWay}" Margin="0,0,20,0"/>
                    <CheckBox Style="{DynamicResource ModernCheckBox}" Content="Exclude Ambiguous" IsChecked="{Binding ExcludeAmbiguousSymbols, Mode=TwoWay}"/>
                </WrapPanel>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,10,0,15"/>

                <!-- Export Actions -->
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Export Options:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Style="{DynamicResource ModernSecondaryButton}" Content="Export as CSV" Command="{Binding ExportCommand}" CommandParameter="csv" Margin="0,0,10,0"/>
                        <Button Style="{DynamicResource ModernSecondaryButton}" Content="Export as JSON" Command="{Binding ExportCommand}" CommandParameter="json" Margin="0,0,10,0"/>
                        <Button Style="{DynamicResource ModernSecondaryButton}" Content="Export as TXT" Command="{Binding ExportCommand}" CommandParameter="txt"/>
                    </StackPanel>

                    <!-- Alert message -->
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="10,5"
                            Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{Binding NotificationMessage}" Foreground="White" FontWeight="Medium" FontSize="13"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Passwords Grid List -->
        <Border Grid.Row="2" Style="{DynamicResource ModernCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      RowBackground="{DynamicResource BgCardBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardHoverBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Password" 
                                        Binding="{Binding Value}" 
                                        Width="*"
                                        FontFamily="Consolas, Cascadia Code"
                                        FontWeight="Bold"/>
                    <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"/>
                    <DataGridTemplateColumn Header="Strength" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Strength.StrengthLabel}"
                                           Foreground="{Binding Strength.Strength, Converter={StaticResource StrengthToColorConverter}}"
                                           FontWeight="Bold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Entropy" Binding="{Binding Strength.EntropyBits, StringFormat='{}{0:F1} bits'}" Width="110"/>
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource ModernSecondaryButton}" 
                                        Content="Copy"
                                        Padding="10,4"
                                        Command="{Binding DataContext.CopySingleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
